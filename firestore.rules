rules_version = '2';

// Every read and write goes through a route handler using the Admin SDK, which
// bypasses these rules. Clients therefore need no access at all, and denying
// everything is the correct posture: contact submissions, job applications and
// offer acceptances are not public data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
