---
import { type Language } from '../../i18n/utils';
import { getLatestVideos, YT_HANDLE_URL, type YtVideo } from '../../lib/youtube';
import { Play, Youtube, ArrowUpRight } from 'lucide-astro';

interface Props { lang: Language; demo?: YtVideo[] }
const { lang, demo } = Astro.props;
const de = lang === 'de';

const t = de
  ? {
      eyebrow: 'Video', title: 'Auf YouTube.', lead: 'Neue Videos erscheinen hier automatisch.',
      channel: 'Kanal öffnen', subscribe: 'Abonnieren', play: 'Video abspielen',
      privacy: 'Das Video wird erst beim Klick von YouTube geladen.',
      emptyTitle: 'Der Kanal startet bald.', emptyText: 'Abonnieren Sie den Kanal, um das erste Video nicht zu verpassen.',
    }
  : {
      eyebrow: 'Video', title: 'On YouTube.', lead: 'New videos appear here automatically.',
      channel: 'Open channel', subscribe: 'Subscribe', play: 'Play video',
      privacy: 'The video only loads from YouTube when you click play.',
      emptyTitle: 'The channel is launching soon.', emptyText: 'Subscribe so you do not miss the first video.',
    };

const videos = demo ?? (await getLatestVideos(3));
const [lead, ...rest] = videos;
const fmt = new Intl.DateTimeFormat(de ? 'de-CH' : 'en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const posterOf = new Map(videos.map((v) => [v.id, v.poster]));
const thumb = (id: string, q = 'hqdefault') => posterOf.get(id) ?? `https://i.ytimg.com/vi/${id}/${q}.jpg`;
---

<section id="media" class="yt">
  <div class="yt-wrap">
    <div class="yt-head">
      <div>
        <p class="yt-eyebrow"><Youtube size={16} /> {t.eyebrow}</p>
        <h2>{t.title}</h2>
        <p class="yt-lead">{t.lead}</p>
      </div>
      <div class="yt-actions">
        <a href={`${YT_HANDLE_URL}?sub_confirmation=1`} target="_blank" rel="noopener me" class="yt-btn yt-btn-fill">{t.subscribe}</a>
        <a href={YT_HANDLE_URL} target="_blank" rel="noopener me" class="yt-btn yt-btn-line">{t.channel} <ArrowUpRight size={15} /></a>
      </div>
    </div>

    {videos.length === 0 ? (
      <a href={`${YT_HANDLE_URL}?sub_confirmation=1`} target="_blank" rel="noopener me" class="yt-empty">
        <span class="yt-empty-play"><Play size={30} /></span>
        <span class="yt-empty-title">{t.emptyTitle}</span>
        <span class="yt-empty-text">{t.emptyText}</span>
      </a>
    ) : (
      <div class={`yt-grid ${rest.length ? '' : 'yt-grid-single'}`}>
        <figure class="yt-card yt-card-lead">
          <button type="button" class="yt-player" data-yt={lead.id} aria-label={`${t.play}: ${lead.title}`}>
            <img src={thumb(lead.id, 'maxresdefault')} onerror={lead.poster ? undefined : `this.src='${thumb(lead.id)}'`} alt="" loading="lazy" width="1280" height="720" />
            <span class="yt-play"><Play size={34} /></span>
          </button>
          <figcaption><span class="yt-date">{fmt.format(lead.published)}</span><span class="yt-title">{lead.title}</span></figcaption>
        </figure>
        {rest.length > 0 && (
          <div class="yt-side">
            {rest.map((v) => (
              <figure class="yt-card">
                <button type="button" class="yt-player" data-yt={v.id} aria-label={`${t.play}: ${v.title}`}>
                  <img src={thumb(v.id)} alt="" loading="lazy" width="480" height="360" />
                  <span class="yt-play yt-play-sm"><Play size={22} /></span>
                </button>
                <figcaption><span class="yt-date">{fmt.format(v.published)}</span><span class="yt-title">{v.title}</span></figcaption>
              </figure>
            ))}
          </div>
        )}
      </div>
    )}
    {videos.length > 0 && <p class="yt-note"><span class="yt-rule" aria-hidden="true"></span>{t.privacy}</p>}
  </div>
</section>

<script>
  // Click-to-play: nothing is loaded from YouTube's player until the visitor asks for it.
  document.querySelectorAll<HTMLButtonElement>('.yt-player[data-yt]').forEach((b) => {
    b.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${b.dataset.yt}?autoplay=1&rel=0`;
      f.title = b.getAttribute('aria-label') ?? 'YouTube';
      f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      f.allowFullscreen = true;
      f.className = 'yt-frame';
      b.replaceWith(f);
    });
  });
</script>

<style>
  .yt { background: var(--bg-secondary); padding: var(--spacing-4xl) 0; }
  .yt-wrap { max-width: 1120px; margin: 0 auto; padding: 0 var(--spacing-lg); }
  .yt-head { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--spacing-xl); flex-wrap: wrap; margin-bottom: var(--spacing-2xl); }
  .yt-eyebrow { display: inline-flex; align-items: center; gap: 6px; margin: 0 0 var(--spacing-sm); color: var(--teal-text); font-weight: 600; font-size: 0.85rem; letter-spacing: 0.12em; text-transform: uppercase; }
  .yt h2 { margin: 0; font-size: clamp(2rem, 4vw, 3rem); line-height: 1.1; color: var(--text-primary); }
  .yt-lead { margin: var(--spacing-sm) 0 0; font-size: 1.15rem; color: var(--text-secondary); }
  .yt-actions { display: flex; gap: var(--spacing-sm); flex-wrap: wrap; }
  .yt-btn { display: inline-flex; align-items: center; gap: 6px; min-height: 46px; padding: 0 var(--spacing-lg); border-radius: var(--radius-full); font-weight: 600; text-decoration: none; }
  .yt-btn-fill { background: var(--action-teal); color: var(--eflury-white); }
  .yt-btn-line { border: 1.5px solid var(--border-color); color: var(--text-primary); }

  .yt-grid { display: grid; grid-template-columns: 1.7fr 1fr; gap: var(--spacing-lg); }
  .yt-grid-single { grid-template-columns: 1fr; max-width: 820px; }
  .yt-side { display: grid; gap: var(--spacing-lg); align-content: start; }
  .yt-card { margin: 0; background: var(--card-bg); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-sm); }
  .yt-player { position: relative; display: block; width: 100%; aspect-ratio: 16 / 9; padding: 0; border: 0; cursor: pointer; background: var(--surface-navy); overflow: hidden; }
  .yt-player img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--transition-slow); }
  .yt-player:hover img { transform: scale(1.04); }
  .yt-play { position: absolute; inset: 0; margin: auto; width: 76px; height: 76px; display: inline-flex; align-items: center; justify-content: center; border-radius: var(--radius-full); background: var(--action-teal); color: var(--eflury-white); box-shadow: var(--shadow-lg); }
  .yt-play-sm { width: 52px; height: 52px; }
  :global(.yt-frame) { display: block; width: 100%; aspect-ratio: 16 / 9; border: 0; }
  .yt-card figcaption { display: flex; flex-direction: column; gap: 4px; padding: var(--spacing-md) var(--spacing-lg) var(--spacing-lg); }
  .yt-date { color: var(--text-tertiary); font-size: 0.82rem; }
  .yt-title { color: var(--text-primary); font-weight: 600; line-height: 1.35; }
  .yt-card-lead { align-self: start; }
  .yt-card-lead .yt-title { font-size: 1.2rem; }

  .yt-empty {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--spacing-sm);
    min-height: 320px; padding: var(--spacing-2xl); border-radius: var(--radius-xl); text-align: center; text-decoration: none;
    background: radial-gradient(circle at 30% 20%, rgb(20 144 208 / 0.35), transparent 60%), var(--surface-navy); color: var(--eflury-white);
  }
  .yt-empty-play { display: inline-flex; width: 76px; height: 76px; align-items: center; justify-content: center; border-radius: var(--radius-full); background: var(--action-teal); margin-bottom: var(--spacing-md); }
  .yt-empty-title { font-size: 1.5rem; font-weight: 700; }
  .yt-empty-text { opacity: 0.8; }

  .yt-note { display: flex; align-items: center; gap: var(--spacing-md); margin: var(--spacing-xl) 0 0; color: var(--text-tertiary); font-size: 0.88rem; }
  .yt-rule { position: relative; display: inline-block; width: 80px; height: 2px; background: var(--eflury-teal); }
  .yt-rule::after { content: ''; position: absolute; right: -4px; top: -4px; width: 10px; height: 10px; border-radius: 50%; background: var(--eflury-teal); }

  @media (max-width: 860px) { .yt-grid { grid-template-columns: 1fr; } .yt { padding: var(--spacing-3xl) 0; } }
  @media (prefers-reduced-motion: reduce) { .yt-player img { transition: none; } }
</style>
