---
import { getCollection } from 'astro:content';
import { type Language } from '../../i18n/utils';
import RealEstate from './RealEstate.astro';
import { ArrowRight, ArrowUpRight, Mail } from 'lucide-astro';

interface Props { lang: Language }
const { lang } = Astro.props;
const de = lang === 'de';

const t = de
  ? {
      eyebrow: 'Unternehmer',
      title: 'Emanuel Flury',
      lead: 'Ich baue Unternehmen dort, wo Finanzen, Steuern und Technologie zusammenkommen.',
      ctaPrimary: 'Was ich aufbaue',
      ctaSecondary: 'Kontakt',
      venturesEyebrow: 'Unternehmen',
      venturesTitle: 'Drei Standbeine. Ein Anspruch.',
      venturesLead: 'Jedes Unternehmen hat seine eigene Website und seine eigenen Kanäle. Hier sehen Sie, wie sie zusammengehören.',
      ventures: [
        { tag: 'Technologie', name: 'Skopa AG', text: 'Künstliche Intelligenz und Automatisierung für Unternehmen. Rolle: Geschäftsführer.', href: 'https://skopa.ai', link: 'skopa.ai' },
        { tag: 'Steuern', name: 'Taxed GmbH', text: 'Steuerberatung für Expats in der Schweiz, mit Büro in Biel/Bienne. Rolle: Geschäftsführer (Mandat).', href: 'https://taxed.ch', link: 'taxed.ch' },
        { tag: 'Immobilien', name: 'Emanuel Flury Real Estate', text: 'Private Investition in Wohnliegenschaften, kein Unternehmen. Rolle: Eigentümer.', href: '#real-estate', link: 'Die drei Liegenschaften' },
      ],
      writingEyebrow: 'Notizen',
      writingTitle: 'Was ich beim Aufbauen lerne.',
      writingAll: 'Alle Beiträge',
      aboutEyebrow: 'Über mich',
      aboutTitle: 'Finanzen gelernt. Automatisierung gelebt. Jetzt Unternehmer.',
      aboutText: 'Ich habe Finance-Economics an der University of Aberdeen studiert und viele Jahre Finanzprozesse in grossen Organisationen automatisiert. Heute setze ich dieses Wissen in meinen eigenen Unternehmen ein. Ich lebe in Grenchen.',
      aboutLink: 'Meine Geschichte',
      followTitle: 'Folgen Sie mir',
      contactTitle: 'Lassen Sie uns sprechen.',
      contactText: 'Für Gespräche, Partnerschaften oder Medienanfragen.',
      contactCta: 'E-Mail schreiben',
      archive: 'eFlury Consulting (Archiv)',
    }
  : {
      eyebrow: 'Entrepreneur',
      title: 'Emanuel Flury',
      lead: 'I build companies where finance, tax and technology meet.',
      ctaPrimary: 'What I build',
      ctaSecondary: 'Get in touch',
      venturesEyebrow: 'Ventures',
      venturesTitle: 'Three ventures. One standard.',
      venturesLead: 'Each company has its own website and channels. This is where they come together.',
      ventures: [
        { tag: 'Technology', name: 'Skopa AG', text: 'Artificial intelligence and automation for businesses. Role: Managing Director.', href: 'https://skopa.ai', link: 'skopa.ai' },
        { tag: 'Tax', name: 'Taxed GmbH', text: 'Tax advice for expats living in Switzerland, with an office in Biel/Bienne. Role: Managing Director (Mandate).', href: 'https://taxed.ch', link: 'taxed.ch' },
        { tag: 'Real estate', name: 'Emanuel Flury Real Estate', text: 'A private investment in residential property, not a company. Role: Owner.', href: '#real-estate', link: 'The three properties' },
      ],
      writingEyebrow: 'Writing',
      writingTitle: 'What I learn while building.',
      writingAll: 'All articles',
      aboutEyebrow: 'About',
      aboutTitle: 'Trained in finance. Shaped by automation. Now building.',
      aboutText: 'I studied Finance-Economics at the University of Aberdeen and spent years automating finance processes in large organisations. Today I put that experience to work in my own companies. I live in Grenchen.',
      aboutLink: 'My story',
      followTitle: 'Follow along',
      contactTitle: "Let's talk.",
      contactText: 'For conversations, partnerships or media requests.',
      contactCta: 'Send an email',
      archive: 'eFlury Consulting (archive)',
    };

const posts = (await getCollection('blog', ({ data }) => data.lang === lang && !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime() || a.id.localeCompare(b.id))
  .slice(0, 3);

const socials = [
  { name: 'LinkedIn', href: 'https://www.linkedin.com/in/emanuelflury' },
  { name: 'Instagram', href: 'https://www.instagram.com/emanuelaaronflury' },
  { name: 'TikTok', href: 'https://www.tiktok.com/@emanuelflury' },
  { name: 'YouTube', href: 'https://www.youtube.com/@emanuelflury' },
  { name: 'Facebook', href: 'https://www.facebook.com/emanuelflury' },
  { name: 'GitHub', href: 'https://github.com/emanuelflury' },
];
const fmt = new Intl.DateTimeFormat(de ? 'de-CH' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<section id="ventures" class="band alt">
  <div class="wrap">
    <p class="eyebrow">{t.venturesEyebrow}</p>
    <h2>{t.venturesTitle}</h2>
    <p class="section-lead">{t.venturesLead}</p>
    <div class="v-grid">
      {t.ventures.map((v) => (
        <article class="v-card">
          <span class="v-tag">{v.tag}</span>
          <h3>{v.name}</h3>
          <p>{v.text}</p>
          {v.href && (
            <a href={v.href} target={v.href.startsWith('#') ? undefined : '_blank'} rel="noopener" class="v-link">{v.link} <ArrowUpRight size={16} /></a>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<RealEstate lang={lang} />

<section id="writing" class="band">
  <div class="wrap">
    <p class="eyebrow">{t.writingEyebrow}</p>
    <h2>{t.writingTitle}</h2>
    <div class="w-grid">
      {posts.map((p) => (
        <a href={`/${lang}/blog/${p.id.replace(/\.md$/, '')}/`} class="w-card">
          <time datetime={p.data.pubDate.toISOString()}>{fmt.format(p.data.pubDate)}</time>
          <h3>{p.data.title}</h3>
          <p>{p.data.description}</p>
        </a>
      ))}
    </div>
    <a href={`/${lang}/blog/`} class="text-link">{t.writingAll} <ArrowRight size={16} /></a>
  </div>
</section>

<section id="about" class="band alt">
  <div class="wrap narrow">
    <p class="eyebrow">{t.aboutEyebrow}</p>
    <h2>{t.aboutTitle}</h2>
    <p class="section-lead">{t.aboutText}</p>
    <a href={`/${lang}/about/`} class="text-link">{t.aboutLink} <ArrowRight size={16} /></a>
  </div>
</section>

<section class="band">
  <div class="wrap narrow center">
    <h2 class="h-small">{t.followTitle}</h2>
    <ul class="s-row">
      {socials.map((s) => (
        <li><a href={s.href} target="_blank" rel="noopener me">{s.name}</a></li>
      ))}
    </ul>
  </div>
</section>

<section id="contact" class="band navy">
  <div class="wrap narrow center">
    <h2>{t.contactTitle}</h2>
    <p class="section-lead">{t.contactText}</p>
    <a href="mailto:me@eflury.com" class="btn-fill"><Mail size={18} /> {t.contactCta}</a>
  </div>
</section>

<style>
  .wrap { max-width: 1120px; margin: 0 auto; padding: 0 var(--spacing-lg); }
  .wrap.narrow { max-width: 760px; }
  .center { text-align: center; }
  .eyebrow {
    color: var(--teal-text);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0 0 var(--spacing-sm);
  }
  .band { padding: var(--spacing-4xl) 0; background: var(--bg-primary); }
  .band.alt { background: var(--bg-secondary); }
  .band.navy { background: var(--surface-navy); color: var(--eflury-white); }
  .band.navy h2 { color: var(--eflury-white); }
  .band.navy .section-lead { color: var(--eflury-white); opacity: 0.85; margin-left: auto; margin-right: auto; }
  h2 { font-size: clamp(2rem, 4vw, 3rem); line-height: 1.1; margin: 0 0 var(--spacing-md); color: var(--text-primary); }
  .h-small { font-size: 1.5rem; }
  .section-lead { font-size: 1.2rem; line-height: 1.6; color: var(--text-secondary); max-width: 640px; margin: 0 0 var(--spacing-xl); }

  .p-hero { padding: calc(var(--header-height) + var(--spacing-3xl)) 0 var(--spacing-3xl); background: var(--bg-primary); }
  .p-hero-grid { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: var(--spacing-3xl); align-items: center; }
  .p-hero h1 { font-size: clamp(3rem, 7vw, 5.5rem); line-height: 1; margin: 0 0 var(--spacing-lg); color: var(--text-primary); letter-spacing: -0.02em; }
  .lead { font-size: clamp(1.25rem, 2.2vw, 1.6rem); line-height: 1.45; color: var(--text-secondary); max-width: 560px; margin: 0 0 var(--spacing-2xl); }
  .p-hero-cta { display: flex; flex-wrap: wrap; gap: var(--spacing-md); }
  .p-hero-photo { display: flex; justify-content: center; }
  .p-hero-photo img { max-height: 560px; width: auto; height: auto; }

  .btn-fill, .btn-line {
    display: inline-flex; align-items: center; gap: var(--spacing-sm);
    padding: 0 var(--spacing-xl); min-height: 48px; border-radius: var(--radius-full);
    font-size: 17px; font-weight: 600; text-decoration: none;
  }
  .btn-fill { background: var(--action-teal); color: var(--eflury-white); }
  .btn-line { border: 1.5px solid var(--border-color); color: var(--text-primary); }

  .v-grid, .w-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--spacing-lg); }
  .v-card, .w-card {
    background: var(--card-bg); border-radius: var(--radius-lg); padding: var(--spacing-xl);
    box-shadow: var(--shadow-sm); display: flex; flex-direction: column; gap: var(--spacing-sm);
  }
  .v-tag { color: var(--teal-text); font-weight: 600; font-size: 0.85rem; }
  .v-card h3, .w-card h3 { margin: 0; font-size: 1.4rem; color: var(--text-primary); }
  .v-card p, .w-card p { margin: 0; color: var(--text-secondary); line-height: 1.55; }
  .v-link, .text-link { display: inline-flex; align-items: center; gap: 6px; color: var(--link-color); font-weight: 600; text-decoration: none; margin-top: auto; }
  .text-link { margin-top: var(--spacing-xl); }
  .w-card { text-decoration: none; transition: box-shadow var(--transition-base); }
  .w-card:hover { box-shadow: var(--shadow-md); }
  .w-card time { color: var(--text-tertiary); font-size: 0.85rem; }
  .w-card h3 { font-size: 1.2rem; }

  .s-row { list-style: none; padding: 0; margin: var(--spacing-lg) 0 0; display: flex; flex-wrap: wrap; justify-content: center; gap: var(--spacing-sm); }
  .s-row a {
    display: inline-flex; align-items: center; padding: 0 var(--spacing-lg); min-height: 44px;
    border: 1px solid var(--border-color); border-radius: var(--radius-full); color: var(--text-primary); text-decoration: none; font-weight: 500;
  }
  .s-row a:hover { border-color: var(--eflury-teal); }

  @media (max-width: 860px) {
    .p-hero-grid { grid-template-columns: 1fr; }
    .p-hero-photo { order: -1; }
    .p-hero-photo img { max-height: 320px; }
    .v-grid, .w-grid { grid-template-columns: 1fr; }
    .band { padding: var(--spacing-3xl) 0; }
  }
</style>
