---
import { type Language, routes } from '../../i18n/utils';
import { ArrowUpRight, Mail } from 'lucide-astro';

interface Props { lang: Language }
const { lang } = Astro.props;
const de = lang === 'de';
const base = `/${lang}/`;
const r = routes[lang];
const year = new Date().getFullYear();

const t = de
  ? {
      role: 'UNTERNEHMER', lead: 'Ich baue Unternehmen dort, wo Finanzen, Steuern und Technologie zusammenkommen.',
      ventures: 'Unternehmen', writing: 'Notizen', about: 'Über mich', legal: 'Rechtliches',
      all: 'Alle Beiträge', latest: 'Neueste Beiträge', topics: 'Themen',
      story: 'Meine Geschichte', archive: 'eFlury Consulting (Archiv)', contact: 'Kontakt',
      imprint: 'Impressum', privacy: 'Datenschutz', terms: 'Nutzungsbedingungen', cookies: 'Cookies',
      rights: 'Alle Rechte vorbehalten.', top: 'Nach oben',
    }
  : {
      role: 'ENTREPRENEUR', lead: 'I build companies where finance, tax and technology meet.',
      ventures: 'Ventures', writing: 'Writing', about: 'About', legal: 'Legal',
      all: 'All articles', latest: 'Latest articles', topics: 'Topics',
      story: 'My story', archive: 'eFlury Consulting (archive)', contact: 'Contact',
      imprint: 'Imprint', privacy: 'Privacy', terms: 'Terms', cookies: 'Cookies',
      rights: 'All rights reserved.', top: 'Back to top',
    };

const socials = [
  { name: 'LinkedIn', href: 'https://www.linkedin.com/in/emanuelflury' },
  { name: 'Instagram', href: 'https://www.instagram.com/emanuelaaronflury' },
  { name: 'TikTok', href: 'https://www.tiktok.com/@emanuelflury' },
  { name: 'YouTube', href: 'https://www.youtube.com/@emanuelflury' },
  { name: 'Facebook', href: 'https://www.facebook.com/emanuelflury' },
  { name: 'GitHub', href: 'https://github.com/emanuelflury' },
];

const cols = [
  {
    title: t.ventures,
    links: [
      { label: 'Skopa AG', href: 'https://skopa.ai', ext: true },
      { label: 'Taxed GmbH', href: 'https://taxed.ch', ext: true },
      { label: 'Emanuel Flury Real Estate', href: `${base}#real-estate` },
    ],
  },
  {
    title: t.writing,
    links: [
      { label: t.latest, href: `${base}#writing` },
      { label: t.all, href: `${base}blog/` },
    ],
  },
  {
    title: t.about,
    links: [
      { label: t.story, href: `${base}about/` },
      { label: t.contact, href: `${base}#contact` },
      { label: t.archive, href: `${base}services/` },
    ],
  },
  {
    title: t.legal,
    links: [
      { label: t.imprint, href: r.imprint },
      { label: t.privacy, href: r.privacy },
      { label: t.terms, href: r.terms },
      { label: t.cookies, href: r.cookies },
    ],
  },
];
---

<footer class="pf">
  <svg class="pf-rule" viewBox="0 0 520 60" aria-hidden="true">
    <line x1="520" y1="16" x2="20" y2="16" /><circle cx="20" cy="16" r="7" />
    <line x1="520" y1="50" x2="220" y2="50" /><circle cx="220" cy="50" r="7" />
  </svg>

  <div class="pf-wrap">
    <div class="pf-top">
      <div class="pf-brand">
        <a href={base} class="pf-logo">
          <img src="/images/ef-mark-white.svg" alt="" width="60" height="48" />
          <span>
            <span class="pf-name">Emanuel Flury</span>
            <span class="pf-role">{t.role}</span>
          </span>
        </a>
        <p class="pf-lead">{t.lead}</p>
        <a href="mailto:me@eflury.com" class="pf-mail"><Mail size={16} /> me@eflury.com</a>
      </div>

      <nav class="pf-cols" aria-label="Footer">
        {cols.map((c) => (
          <div>
            <p class="pf-col-title">{c.title}</p>
            <ul>
              {c.links.map((l) => (
                <li>
                  <a href={l.href} target={l.ext ? '_blank' : undefined} rel={l.ext ? 'noopener' : undefined}>
                    {l.label}{l.ext && <ArrowUpRight size={13} />}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <ul class="pf-social">
      {socials.map((s) => (
        <li><a href={s.href} target="_blank" rel="noopener me">{s.name} <ArrowUpRight size={13} /></a></li>
      ))}
    </ul>

    <div class="pf-bottom">
      <p>© {year} Emanuel Flury · Grenchen · {t.rights}</p>
      <p class="pf-tag">TECH <b>·</b> TAX <b>·</b> REAL ESTATE</p>
      <p class="pf-lang">
        <a href="/en/" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
        <a href="/de/" aria-current={lang === 'de' ? 'true' : undefined}>DE</a>
      </p>
    </div>
  </div>

  <p class="pf-word" aria-hidden="true" style="background-image:url(/images/hero/sky.webp)">EMANUEL FLURY</p>
</footer>

<style>
  .pf {
    position: relative;
    overflow: hidden;
    background: var(--surface-navy);
    color: var(--eflury-white);
    padding: var(--spacing-4xl) 0 0;
    border-top: 1px solid rgb(255 255 255 / 0.08);
  }
  .pf-rule { position: absolute; top: var(--spacing-xl); right: 0; width: clamp(200px, 30vw, 460px); height: auto; }
  .pf-rule line { stroke: var(--eflury-blue); stroke-width: 2.5; opacity: 0.45; }
  .pf-rule circle { fill: var(--eflury-blue); opacity: 0.8; }

  .pf-wrap { position: relative; max-width: 1200px; margin: 0 auto; padding: 0 var(--spacing-lg); }
  .pf-top { display: grid; grid-template-columns: 1fr 2fr; gap: var(--spacing-3xl); }

  .pf-logo { display: inline-flex; align-items: center; gap: var(--spacing-md); color: var(--eflury-white); text-decoration: none; }
  .pf-logo > span { display: flex; flex-direction: column; }
  .pf-name { font-family: 'Montserrat', sans-serif; font-weight: 800; font-size: 1.6rem; line-height: 1; text-transform: uppercase; }
  .pf-role { margin-top: 8px; color: var(--eflury-blue); font-weight: 700; font-size: 0.8rem; letter-spacing: 0.42em; }
  .pf-lead { margin: var(--spacing-lg) 0; max-width: 340px; line-height: 1.6; opacity: 0.8; }
  .pf-mail {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 var(--spacing-lg);
    border-radius: var(--radius-full); border: 1px solid rgb(255 255 255 / 0.2); color: var(--eflury-white); text-decoration: none; font-weight: 600;
  }
  .pf-mail:hover { border-color: var(--eflury-blue); }

  .pf-cols { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--spacing-xl); }
  .pf-col-title { margin: 0 0 var(--spacing-md); color: var(--eflury-blue); font-weight: 700; font-size: 0.78rem; letter-spacing: 0.16em; text-transform: uppercase; }
  .pf-cols ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--spacing-xs); }
  .pf-cols a {
    display: inline-flex; align-items: center; gap: 4px; min-height: 36px;
    color: var(--eflury-white); opacity: 0.8; text-decoration: none; font-size: 0.95rem;
  }
  .pf-cols a:hover { opacity: 1; text-decoration: underline; text-underline-offset: 3px; }

  .pf-social { list-style: none; margin: var(--spacing-3xl) 0 0; padding: var(--spacing-xl) 0; display: flex; flex-wrap: wrap; gap: var(--spacing-sm); border-top: 1px solid rgb(255 255 255 / 0.08); }
  .pf-social a {
    display: inline-flex; align-items: center; gap: 4px; min-height: 40px; padding: 0 var(--spacing-md);
    border-radius: var(--radius-full); background: rgb(255 255 255 / 0.06); color: var(--eflury-white); text-decoration: none; font-size: 0.9rem; font-weight: 500;
  }
  .pf-social a:hover { background: rgb(255 255 255 / 0.12); }

  .pf-bottom {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--spacing-md);
    padding: var(--spacing-lg) 0; border-top: 1px solid rgb(255 255 255 / 0.08); font-size: 0.85rem;
  }
  .pf-bottom p { margin: 0; opacity: 0.75; }
  .pf-tag { letter-spacing: 0.24em; font-weight: 600; }
  .pf-tag b { color: var(--eflury-blue); }
  .pf-lang { display: flex; gap: var(--spacing-xs); }
  .pf-lang a { display: inline-flex; align-items: center; justify-content: center; min-width: 40px; min-height: 32px; border-radius: var(--radius-full); color: var(--eflury-white); text-decoration: none; font-weight: 600; }
  .pf-lang a[aria-current='true'] { background: rgb(255 255 255 / 0.12); }

  .pf-word {
    margin: var(--spacing-xl) 0 -0.16em;
    text-align: center; white-space: nowrap;
    font-family: 'Montserrat', sans-serif; font-weight: 800; font-size: min(9.2vw, 11rem); letter-spacing: -0.01em; line-height: 1;
    color: transparent; background-size: 120% auto; background-position: 0% 50%;
    -webkit-background-clip: text; background-clip: text; opacity: 0.35;
    animation: pf-pan 30s ease-in-out infinite alternate;
  }
  @keyframes pf-pan { to { background-position: 100% 50%; } }

  @media (max-width: 960px) {
    .pf-top { grid-template-columns: 1fr; gap: var(--spacing-2xl); }
    .pf-cols { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .pf-bottom { flex-direction: column; align-items: flex-start; }
  }
  @media (prefers-reduced-motion: reduce) { .pf-word { animation: none; } }
</style>
