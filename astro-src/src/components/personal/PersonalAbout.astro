---
import { type Language } from '../../i18n/utils';
import BrandWord from './BrandWord.astro';
import { ArrowRight, GraduationCap, Workflow, Rocket } from 'lucide-astro';

interface Props { lang: Language }
const { lang } = Astro.props;
const de = lang === 'de';

// Content rules: verified facts only; past kept light; no employer names.
const t = de
  ? {
      eyebrow: 'Über mich',
      title: 'Finanzen gelernt. Automatisierung gelebt. Jetzt Unternehmer.',
      text: 'Ich verbinde drei Dinge, die selten zusammenkommen: ein Studium in Finanzen, viele Jahre Automatisierung von Finanzprozessen in grossen Organisationen und den Schritt ins eigene Unternehmertum.',
      chapters: [
        { icon: 'grad', kicker: 'Fundament', title: 'Finanzen', text: 'MA in Finance-Economics, University of Aberdeen, mit einem Austauschjahr an der University of Wisconsin-La Crosse. Dazu ein Zertifikat als Steuerspezialist.' },
        { icon: 'flow', kicker: 'Erfahrung', title: 'Automatisierung', text: 'Viele Jahre Finanzprozesse in grossen Organisationen automatisiert. Daraus kommt mein Blick für Systeme statt Stunden.' },
        { icon: 'rocket', kicker: 'Heute', title: 'Unternehmer', text: 'Geschäftsführer der Skopa AG, Geschäftsführer (Mandat) der Taxed GmbH und Eigentümer von EF Real Estate.' },
      ],
      quote: 'Life · Lessons · Building companies',
      place: 'Grenchen',
      link: 'Meine ganze Geschichte',
    }
  : {
      eyebrow: 'About',
      title: 'Trained in finance. Shaped by automation. Now building.',
      text: 'I bring together three things that rarely meet: a degree in finance, years of automating finance processes in large organisations, and the step into building my own companies.',
      chapters: [
        { icon: 'grad', kicker: 'Foundation', title: 'Finance', text: 'MA in Finance-Economics from the University of Aberdeen, with an exchange year at the University of Wisconsin-La Crosse. Plus a certificate as a tax specialist.' },
        { icon: 'flow', kicker: 'Experience', title: 'Automation', text: 'Years spent automating finance processes in large organisations. That is where I learned to think in systems, not hours.' },
        { icon: 'rocket', kicker: 'Today', title: 'Entrepreneur', text: 'Managing Director of Skopa AG, Managing Director (Mandate) of Taxed GmbH and owner of EF Real Estate.' },
      ],
      quote: 'Life · Lessons · Building companies',
      place: 'Grenchen',
      link: 'My full story',
    };
---

<section id="about" class="ab">
  <div class="ab-wrap">
    <div class="ab-photo">
      <div class="ab-photo-card">
        <svg class="ab-rule" viewBox="0 0 320 60" aria-hidden="true">
          <line x1="0" y1="12" x2="300" y2="12" /><circle cx="300" cy="12" r="7" />
          <line x1="0" y1="44" x2="180" y2="44" /><circle cx="180" cy="44" r="7" />
        </svg>
        <img src="/images/portraits/emanuel-aaron-flury-portrait.webp" alt="Emanuel Flury" width="714" height="1616" loading="lazy" />
        <div class="ab-badge">
          <img src="/images/ef-mark-white.svg" alt="" width="40" height="32" />
          <span><strong>Emanuel Flury</strong><span>{t.place}</span></span>
        </div>
      </div>
      <p class="ab-quote">{t.quote}</p>
    </div>

    <div class="ab-text">
      <BrandWord word="LEAD" img="arches" />
      <p class="ab-eyebrow">{t.eyebrow}</p>
      <h2>{t.title}</h2>
      <p class="ab-lead">{t.text}</p>

      <ol class="ab-chapters">
        {t.chapters.map((c, i) => (
          <li>
            <span class="ab-icon">
              {c.icon === 'grad' && <GraduationCap size={22} />}
              {c.icon === 'flow' && <Workflow size={22} />}
              {c.icon === 'rocket' && <Rocket size={22} />}
            </span>
            <div>
              <p class="ab-kicker">0{i + 1} · {c.kicker}</p>
              <h3>{c.title}</h3>
              <p>{c.text}</p>
            </div>
          </li>
        ))}
      </ol>

      <a href={`/${lang}/about/`} class="ab-link">{t.link} <ArrowRight size={16} /></a>
    </div>
  </div>
</section>

<style>
  .ab { background: linear-gradient(rgb(0 0 0 / 0.18), rgb(0 0 0 / 0.18)), var(--surface-navy); color: var(--eflury-white); padding: var(--spacing-4xl) 0; }
  .ab-wrap { max-width: 1120px; margin: 0 auto; padding: 0 var(--spacing-lg); display: grid; grid-template-columns: 0.85fr 1.15fr; gap: var(--spacing-3xl); align-items: center; }

  .ab-photo-card {
    position: relative; height: 560px; border-radius: var(--radius-xl); overflow: hidden;
    background: radial-gradient(circle at 35% 25%, rgb(20 144 208 / 0.45), transparent 60%), var(--surface-navy);
    box-shadow: var(--shadow-lg);
  }
  .ab-photo-card > img { position: absolute; left: 50%; top: var(--spacing-xl); transform: translateX(-50%); height: 760px; width: auto; }
  .ab-rule { position: absolute; top: var(--spacing-lg); left: 0; width: 200px; height: auto; z-index: 1; }
  .ab-rule line { stroke: var(--eflury-blue); stroke-width: 2.5; opacity: 0.6; }
  .ab-rule circle { fill: var(--eflury-blue); }
  .ab-badge {
    position: absolute; left: var(--spacing-md); right: var(--spacing-md); bottom: var(--spacing-md); z-index: 1;
    display: flex; align-items: center; gap: var(--spacing-md); padding: var(--spacing-md) var(--spacing-lg);
    border-radius: var(--radius-lg); background: var(--surface-navy); border: 1px solid rgb(255 255 255 / 0.12);
    color: var(--eflury-white);
  }
  .ab-badge > span { display: flex; flex-direction: column; }
  .ab-badge strong { font-size: 1.05rem; }
  .ab-badge span span { font-size: 0.85rem; opacity: 0.75; }
  .ab-quote { margin: var(--spacing-lg) 0 0; text-align: center; color: var(--eflury-white); opacity: 0.7; font-weight: 600; letter-spacing: 0.08em; }

  .ab-eyebrow { margin: 0 0 var(--spacing-sm); color: var(--eflury-blue); font-weight: 600; font-size: 0.85rem; letter-spacing: 0.12em; text-transform: uppercase; }
  .ab h2 { margin: 0 0 var(--spacing-md); font-size: clamp(2rem, 4vw, 2.9rem); line-height: 1.1; color: var(--eflury-white); }
  .ab-lead { margin: 0 0 var(--spacing-xl); font-size: 1.15rem; line-height: 1.6; color: var(--eflury-white); opacity: 0.8; }

  .ab-chapters { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--spacing-md); }
  .ab-chapters li { display: flex; gap: var(--spacing-md); padding: var(--spacing-lg); border-radius: var(--radius-lg); background: rgb(255 255 255 / 0.04); border: 1px solid rgb(255 255 255 / 0.09); }
  .ab-icon { flex: none; display: inline-flex; width: 44px; height: 44px; align-items: center; justify-content: center; border-radius: var(--radius-md); background: rgb(255 255 255 / 0.08); color: var(--eflury-blue); }
  .ab-kicker { margin: 0; color: var(--eflury-blue); font-weight: 700; font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; }
  .ab-chapters h3 { margin: 2px 0 4px; font-size: 1.2rem; color: var(--eflury-white); }
  .ab-chapters p:last-child { margin: 0; color: var(--eflury-white); opacity: 0.75; line-height: 1.55; }
  .ab-link { display: inline-flex; align-items: center; gap: 6px; margin-top: var(--spacing-xl); color: var(--eflury-white); font-weight: 600; text-decoration: none; }

  @media (max-width: 860px) {
    .ab-wrap { grid-template-columns: 1fr; gap: var(--spacing-2xl); }
    .ab-photo-card { height: 420px; }
    .ab-photo-card > img { height: 600px; }
    .ab { padding: var(--spacing-3xl) 0; }
  }
</style>
