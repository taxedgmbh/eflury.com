---
import { type Language } from '../../i18n/utils';
import { ArrowRight } from 'lucide-astro';

interface Props { lang: Language }
const { lang } = Astro.props;
const de = lang === 'de';
const t = de
  ? { lead: 'Ich baue Unternehmen dort, wo Finanzen, Steuern und Technologie zusammenkommen.', primary: 'Was ich aufbaue', secondary: 'Kontakt', role: 'UNTERNEHMER' }
  : { lead: 'I build companies where finance, tax and technology meet.', primary: 'What I build', secondary: 'Get in touch', role: 'ENTREPRENEUR' };

// Same photo-in-letters look as the social media word rows; scenery only, no faces.
const fills = ['palms', 'sky', 'arches', 'city'];
---

<section class="bh" aria-labelledby="bh-title">
  <canvas class="bh-canvas" aria-hidden="true"></canvas>
  <div class="bh-vignette" aria-hidden="true"></div>
  <svg class="bh-rule bh-rule-tl" viewBox="0 0 520 60" aria-hidden="true">
    <line class="bh-line" x1="0" y1="10" x2="500" y2="10" /><circle class="bh-dot" cx="500" cy="10" r="7" />
    <line class="bh-line bh-line-2" x1="0" y1="44" x2="300" y2="44" /><circle class="bh-dot bh-dot-2" cx="300" cy="44" r="7" />
  </svg>
  <svg class="bh-rule bh-rule-br" viewBox="0 0 520 60" aria-hidden="true">
    <line class="bh-line" x1="520" y1="16" x2="20" y2="16" /><circle class="bh-dot" cx="20" cy="16" r="7" />
    <line class="bh-line bh-line-2" x1="520" y1="50" x2="220" y2="50" /><circle class="bh-dot bh-dot-2" cx="220" cy="50" r="7" />
  </svg>
  <div class="bh-content">
    <img class="bh-mark" src="/images/ef-mark-white.svg" alt="" width="250" height="200" />
    <h1 id="bh-title" class="bh-word">
      {fills.map((f, i) => (
        <span class={`bh-fill bh-fill-${i}`} style={`background-image:url(/images/hero/${f}.webp)`} aria-hidden={i > 0 ? 'true' : undefined}>
          EMANUEL<br />FLURY
        </span>
      ))}
    </h1>
    <p class="bh-sub">{t.role}</p>
    <p class="bh-lead">{t.lead}</p>
    <div class="bh-cta">
      <a href="#ventures" class="bh-btn bh-btn-fill">{t.primary} <ArrowRight size={18} /></a>
      <a href="#contact" class="bh-btn bh-btn-line">{t.secondary}</a>
    </div>
  </div>
</section>

<script>
  import { mountHeroNetwork } from '../../scripts/hero-network';
  const canvas = document.querySelector<HTMLCanvasElement>('.bh-canvas');
  if (canvas) mountHeroNetwork(canvas).catch(() => {});
</script>

<style>
  @font-face {
    font-family: 'Montserrat';
    font-weight: 800;
    font-display: swap;
    src: url('/fonts/montserrat-latin-800-normal.woff2') format('woff2');
  }

  .bh {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--surface-navy);
    padding: calc(var(--header-height) + var(--spacing-2xl)) var(--spacing-lg) var(--spacing-3xl);
    isolation: isolate;
  }
  .bh-canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -2; }
  .bh-vignette {
    position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(ellipse at center, transparent 30%, var(--surface-navy) 85%);
  }
  .bh-content { text-align: center; max-width: 1200px; }
  .bh-mark {
    display: block;
    width: clamp(64px, min(8vw, 11vh), 112px);
    height: auto;
    margin: 0 auto var(--spacing-xl);
    animation: bh-rise 0.9s var(--ease-out) both;
  }

  /* Brand rules: the horizontal lines with an end dot from the social banners */
  .bh-rule {
    position: absolute;
    width: clamp(220px, 34vw, 520px);
    height: auto;
    z-index: -1;
    overflow: visible;
  }
  .bh-rule-tl { top: calc(var(--header-height) + var(--spacing-2xl)); left: 0; }
  .bh-rule-br { bottom: var(--spacing-lg); right: 0; }
  .bh-line {
    stroke: var(--eflury-blue);
    stroke-width: 2.5;
    opacity: 0.45;
    stroke-dasharray: 520;
    stroke-dashoffset: 520;
    animation: bh-draw 1.6s var(--ease-out) 0.3s forwards;
  }
  .bh-line-2 { animation-delay: 0.6s; }
  .bh-dot {
    fill: var(--eflury-blue);
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: bh-dot-in 0.5s var(--ease-out) 1.6s forwards, bh-pulse 4s ease-in-out 2.2s infinite;
  }
  .bh-dot-2 { animation-delay: 1.9s, 2.6s; }

  @keyframes bh-draw { to { stroke-dashoffset: 0; } }
  @keyframes bh-dot-in { to { opacity: 0.8; } }
  @keyframes bh-pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.45); } }
  @keyframes bh-rise { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }

  .bh-word {
    position: relative;
    display: inline-grid;
    margin: 0;
    font-family: 'Montserrat', var(--font-family, sans-serif);
    font-weight: 800;
    font-size: clamp(3.4rem, min(13vw, 16vh), 11.5rem);
    line-height: 0.88;
    letter-spacing: 0.01em;
    filter: drop-shadow(0 18px 40px rgb(0 0 0 / 0.45));
  }
  .bh-fill {
    grid-area: 1 / 1;
    color: transparent;
    background-size: 135% auto;
    background-position: 0% 50%;
    -webkit-background-clip: text;
    background-clip: text;
    opacity: 0;
    animation: bh-pan 24s ease-in-out infinite alternate, bh-cycle 24s linear infinite;
  }
  .bh-fill-0 { opacity: 1; animation-delay: 0s, 0s; }
  .bh-fill-1 { animation-delay: -6s, 6s; }
  .bh-fill-2 { animation-delay: -12s, 12s; }
  .bh-fill-3 { animation-delay: -18s, 18s; }
  .bh-fill-0 { animation: bh-pan 24s ease-in-out infinite alternate, bh-cycle-first 24s linear infinite; }

  @keyframes bh-pan {
    from { background-position: 0% 40%; background-size: 135% auto; }
    to   { background-position: 100% 60%; background-size: 150% auto; }
  }
  /* each fill is visible for a quarter of the cycle, with soft crossfades */
  @keyframes bh-cycle {
    0%   { opacity: 0; }
    4%   { opacity: 1; }
    25%  { opacity: 1; }
    29%  { opacity: 0; }
    100% { opacity: 0; }
  }
  @keyframes bh-cycle-first {
    0%   { opacity: 1; }
    25%  { opacity: 1; }
    29%  { opacity: 0; }
    96%  { opacity: 0; }
    100% { opacity: 1; }
  }

  .bh-sub {
    margin: var(--spacing-xl) 0 0;
    padding-left: 0.45em;
    color: var(--eflury-blue);
    font-weight: 700;
    font-size: 1.2rem; /* large-text size keeps brand blue AA on navy */
    letter-spacing: 0.45em;
  }
  .bh-lead {
    margin: var(--spacing-xl) auto var(--spacing-2xl);
    max-width: 620px;
    text-wrap: balance;
    color: var(--eflury-white);
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    line-height: 1.5;
  }
  .bh-cta { display: flex; flex-wrap: wrap; gap: var(--spacing-md); justify-content: center; }
  .bh-btn {
    display: inline-flex; align-items: center; gap: var(--spacing-sm);
    min-height: 48px; padding: 0 var(--spacing-xl); border-radius: var(--radius-full);
    font-size: 17px; font-weight: 600; text-decoration: none;
  }
  .bh-btn-fill { background: var(--action-teal); color: var(--eflury-white); }
  .bh-btn-line { border: 1.5px solid rgb(255 255 255 / 0.45); color: var(--eflury-white); }
  .bh-btn-line:hover { border-color: var(--eflury-white); }

  @media (max-width: 640px) {
    .bh-rule { width: 200px; }
    .bh-sub { letter-spacing: 0.3em; padding-left: 0.3em; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bh-line { animation: none; stroke-dashoffset: 0; }
    .bh-dot { animation: none; opacity: 0.8; }
    .bh-mark { animation: none; }
    .bh-fill { animation: none; }
    .bh-fill-0 { opacity: 1; }
  }
</style>
