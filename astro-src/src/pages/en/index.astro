---
import MainLayout from '../../layouts/MainLayout.astro';
import PersonalHeader from '../../components/personal/PersonalHeader.astro';
import BrandHero from '../../components/personal/BrandHero.astro';
import PersonalHome from '../../components/personal/PersonalHome.astro';
import PersonalFooter from '../../components/personal/PersonalFooter.astro';

const lang = 'en';
---

<MainLayout
  title="Emanuel Flury · Entrepreneur"
  description="Emanuel Flury builds companies where finance, tax and technology meet: Skopa AG, Taxed GmbH and real estate."
  keywords="Emanuel Flury, entrepreneur, Skopa AG, Taxed GmbH"
  lang={lang}
>
  <Fragment slot="head">
    <link rel="preload" href="/fonts/montserrat-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/images/hero/palms.webp" as="image" />
  </Fragment>
  <PersonalHeader lang={lang} />
  <main id="main-content">
    <BrandHero lang={lang} />
    <PersonalHome lang={lang} />
  </main>
  <PersonalFooter lang={lang} />
</MainLayout>
